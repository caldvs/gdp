NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# AWS / local infra (LocalStack + DynamoDB Local for dev)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local-secret
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_BILLS=gdp-bills-raw-dev

# Auth (deferred to foundations checkpoint)
GOOGLE_CLIENT_ID=

# Bill parser (Gemini 2.5 Flash, free tier)
GEMINI_API_KEY=

# Payment provider — `mock` for local dev, `truelayer` once sandbox creds are wired
PAYMENT_PROVIDER=mock
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_WEBHOOK_SECRET=local-mock-secret
TRUELAYER_ENVIRONMENT=sandbox
