{
  "name": "gdp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Group Dine Pay backend API",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "dev": "docker compose up -d && tsx scripts/dev-bootstrap.ts && tsx watch src/local.ts",
    "dev:bootstrap": "tsx scripts/dev-bootstrap.ts",
    "test:e2e:multi": "tsx scripts/e2e-multi-diner.ts",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:int",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "openapi:lint": "redocly lint openapi.yaml",
    "ddb:up": "docker compose up -d",
    "ddb:down": "docker compose down",
    "cdk": "cdk",
    "smoke": "tsx scripts/smoke.ts",
    "validate:bundle": "tsx scripts/validate-bundle.ts",
    "deploy:dev": "npm run validate:bundle && cdk deploy GdpBackendDev --profile gdp-dev --outputs-file cdk-outputs.dev.json --require-approval never && tsx scripts/smoke.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.1",
    "aws-xray-sdk-core": "^3.10.0",
    "google-auth-library": "^9.15.0",
    "hono": "^4.6.0",
    "pino": "^9.5.0",
    "truelayer-signing": "^0.2.1",
    "uuid": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@redocly/cli": "^1.25.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}
