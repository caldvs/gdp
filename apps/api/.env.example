NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# AWS / local infra (LocalStack + DynamoDB Local for dev)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local-secret
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_BILLS=gdp-bills-raw-dev

# Auth (deferred to foundations checkpoint)
GOOGLE_CLIENT_ID=

# Bill parser (Gemini 2.5 Flash, free tier)
GEMINI_API_KEY=

# Payment provider — `mock` for local dev, `manual` for free production
# (guests pay via their own banking app, lead confirms receipt), or
# `truelayer` for full PIS UX (requires TrueLayer Live contract).
PAYMENT_PROVIDER=mock
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_WEBHOOK_SECRET=local-mock-secret   # only consumed by the mock provider
TRUELAYER_ENVIRONMENT=sandbox
# Required when PAYMENT_PROVIDER=truelayer (Lambda gets these from SSM/Secrets Mgr):
TRUELAYER_SIGNING_KID=
TRUELAYER_SIGNING_PRIVATE_KEY_PEM=
TRUELAYER_RETURN_URI=

# Stripe: the lead's table fee (£2, or £3 over £100), paid in Stripe's embedded form.
# Leave STRIPE_SECRET_KEY empty to run without the billing routes.
# Keys: https://dashboard.stripe.com/test/apikeys
# Webhook secret for local dev: run `stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded --forward-to localhost:3000/webhooks/stripe`
# and paste the whsec_... it prints.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where the web app runs; Stripe returns the lead here if a payment method needs a redirect.
APP_BASE_URL=http://localhost:8081
