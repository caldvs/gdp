# Local settings for `npm run dev`. Copy to .env.local (gitignored).
# The deployed Lambda gets its values from infra/main.ts, not from here.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# DynamoDB Local and MinIO from docker-compose.yml. The credentials are dummies they accept.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local-secret
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_BILLS=gdp-bills-raw-dev

# Sign-in. Locally a fixed dev secret is used when this is unset.
# SESSION_JWT_SECRET=at-least-16-characters
# Sign in with just an email (local DynamoDB only). Set to false to use emailed codes.
AUTH_DEV_EMAIL_SIGNIN=
# Sends codes and bill reports through SES. Unset: emails are printed to the console.
# SES_FROM_EMAIL=you@example.com

# Bill reading. Gemini alone unless BEDROCK_MODEL_ID is set, which makes Bedrock
# the main reader (needs real AWS credentials) and Gemini the fallback.
GEMINI_API_KEY=
BEDROCK_MODEL_ID=
# Matches the venue on the bill to a Google Place. Unset: the venue text is kept as read.
GOOGLE_PLACES_API_KEY=

# Diner payments: `mock` locally, `manual` when deployed (guests transfer, the lead
# confirms). `truelayer` needs a live contract and the TRUELAYER_* settings in
# src/config/env.ts.
PAYMENT_PROVIDER=mock

# Table fee (see docs/table-fee.md). Unset STRIPE_SECRET_KEY: no billing routes, no fee.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:8081
