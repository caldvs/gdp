{
  "name": "@gdp/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Group Dine Pay client logic: typed API client, React Query hooks, money/QR/payout helpers.",
  "type": "module",
  "exports": {
    "./api": "./src/api/index.ts",
    "./api/*": "./src/api/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../apps/api/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "heic2any": "^0.0.4",
    "js-sha256": "^0.11.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  }
}
