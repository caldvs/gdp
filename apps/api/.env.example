# Local API settings. Copy to .env.local and fill in what you need.
# Deployed Lambdas get these from CDK (infra/main.ts), SSM and Secrets Manager.

# Which environment this is: local | dev | prod. Only `local` here.
APP_ENV=local
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local AWS stand-ins (docker compose: DynamoDB Local on :8000, MinIO on :9000).
# Their clients carry their own dummy credentials, so AWS_PROFILE below is
# only used for Bedrock. Don't set AWS_ACCESS_KEY_ID here: it would win over
# the profile.
AWS_REGION=eu-west-2
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
DDB_TABLE_NAME=gdp-dev
S3_BUCKET_BILLS=gdp-bills-raw-dev

# Sign-in. Locally you sign in with just an email (turn off with
# AUTH_DEV_EMAIL_SIGNIN=false). AUTH_BYPASS_LOCAL=true accepts `dev:<userId>`
# tokens from anyone, for multi-user scripts; it refuses to start unless
# APP_ENV=local and DYNAMODB_ENDPOINT is set.
# AUTH_DEV_EMAIL_SIGNIN=false
# AUTH_BYPASS_LOCAL=true
# Optional locally (a fixed dev-only secret is used when unset). 16+ characters.
# Leave optional settings commented out rather than empty: an empty value
# counts as set, and some (email, URL, JWT secret) then fail validation.
# SESSION_JWT_SECRET=

# Bill reader: Claude on Amazon Bedrock, which also reads the venue's name and
# address. Needs an AWS profile that can call Bedrock (gdp-dev can). Without
# these, scanning fails with a clear error and everything else works.
AWS_PROFILE=gdp-dev
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6

# Venue lookup, as deployed: Amazon Location Service with the same AWS
# profile. It fills in the venue's real name, full address and coordinates (a
# receipt that prints "d Maiora" comes out as the restaurant's listed name when
# Location matches it). Each new venue is a paid lookup, cached in the local
# table. A lookup that fails (no credentials, no permission) leaves the venue
# as read off the bill. `none` turns it off.
VENUE_LOOKUP=amazon-location

# Email sender (verified in SES). Unset locally: emails are printed instead.
# SES_FROM_EMAIL=

# Stripe: the lead's table fee. Leave STRIPE_SECRET_KEY commented out to run without
# the billing routes. Locally use a test-mode key (sk_test_ or rk_test_):
# https://dashboard.stripe.com/test/apikeys
# Webhook secret: `npm run dev:local` runs `stripe listen` for you (see
# scripts/dev-stripe.mjs). Set this to the secret it uses — get it with
#   stripe listen --print-secret
# and paste the whsec_... Without a match, the API rejects every event and the
# payment page spins forever; the dev runner warns when they differ.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Where the web app runs; Stripe returns the lead here if a payment method
# needs a redirect.
APP_BASE_URL=http://localhost:8081
