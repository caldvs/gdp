# Which environment this build is for: local | dev | prod. Off Vercel it
# defaults to local; on Vercel it must be set, or the build fails
# (packages/core/src/lib/buildEnv.ts).
NEXT_PUBLIC_APP_ENV=

# API origin. Required for dev and prod builds (https). Unset in a local build
# means the local API at http://localhost:3000 (npm run dev:api).
NEXT_PUBLIC_API_BASE_URL=

# Public URL of this web app, used inside QR codes / share links so they
# open from another phone. Defaults to the current window origin.
NEXT_PUBLIC_PUBLIC_BASE_URL=

# "true" turns on the public-demo guardrails (banner, locked payout form, noindex)
NEXT_PUBLIC_DEMO_MODE=

# "1" shows the dev sign-in shortcuts (backend must run with AUTH_BYPASS_LOCAL=true).
# They also appear automatically when NEXT_PUBLIC_API_BASE_URL is a localhost/LAN/tunnel URL.
NEXT_PUBLIC_DEV_SIGNIN=

# Stripe publishable key for the table-fee form: pk_test_ for local and dev,
# pk_live_ for prod (the build checks). Secret keys never go here.
# https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
