# Local API settings. Copy to .env.local and fill in what you need.
# Deployed Lambdas get these from CDK (infra/main.ts), SSM and Secrets Manager.

# Which environment this is: local | dev | prod. Only `local` here.
APP_ENV=local
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local AWS stand-ins (docker compose: DynamoDB Local on :8000, MinIO on :9000)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local-secret
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
DDB_TABLE_NAME=gdp-dev
S3_BUCKET_BILLS=gdp-bills-raw-dev

# Sign-in. Locally you sign in with just an email (turn off with
# AUTH_DEV_EMAIL_SIGNIN=false). AUTH_BYPASS_LOCAL=true accepts `dev:<userId>`
# tokens from anyone, for multi-user scripts; it refuses to start unless
# APP_ENV=local and DYNAMODB_ENDPOINT is set.
# AUTH_DEV_EMAIL_SIGNIN=false
# AUTH_BYPASS_LOCAL=true
# Optional locally (a fixed dev-only secret is used when unset). 16+ characters.
# Leave optional settings commented out rather than empty: an empty value
# counts as set, and some (email, URL, JWT secret) then fail validation.
# SESSION_JWT_SECRET=

# Bill reader. Set BEDROCK_MODEL_ID (with AWS credentials that can call
# Bedrock) to read with Claude on Bedrock; Gemini is the fallback, or the only
# reader when BEDROCK_MODEL_ID is unset. One of the two is needed to scan.
GEMINI_API_KEY=
# BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Venue lookup (Google Places, New). Optional: without it the venue is the
# text on the bill.
# GOOGLE_PLACES_API_KEY=

# Email sender (verified in SES). Unset locally: emails are printed instead.
# SES_FROM_EMAIL=

# How guests pay the lead. `manual` (their own banking app) is what's
# deployed; `mock` fakes a provider locally; `truelayer` needs the TRUELAYER_*
# settings below and a TrueLayer contract.
PAYMENT_PROVIDER=mock
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# TRUELAYER_WEBHOOK_SECRET=
# TRUELAYER_ENVIRONMENT=sandbox
# TRUELAYER_SIGNING_KID=
# TRUELAYER_SIGNING_PRIVATE_KEY_PEM=
# TRUELAYER_RETURN_URI=

# Stripe: the lead's table fee. Leave STRIPE_SECRET_KEY commented out to run without
# the billing routes. Locally use a test-mode key (sk_test_ or rk_test_):
# https://dashboard.stripe.com/test/apikeys
# Webhook secret: run
#   stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded --forward-to localhost:3000/webhooks/stripe
# and paste the whsec_... it prints.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Where the web app runs; Stripe returns the lead here if a payment method
# needs a redirect.
APP_BASE_URL=http://localhost:8081
